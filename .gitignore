# Source code and documentation stay in Git. Runtime data/models are distributed
# separately using ARTIFACTS.json. Ignoring an artifact does NOT remove it from
# deployment: FISCYCLE_GALLERY_DATA.zip is REQUIRED for the full MVP gallery.

# Generated release packages and build staging
/FISCYCLE_DEV_HANDOVER/
/FISCYCLE_DEV_HANDOVER.zip
/FISCYCLE_GALLERY_DATA.zip
/.handover_stage_*/
/.gallery_bundle_*
/.handover_docs_*

# Python environments (including the existing nested .venv-cuda)
.venv/
.venv-*/
.venv.*/
venv/
venv-*/
env/
env-*/
.Python
pyvenv.cfg

