# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Internal AI data and runtime
/PRIVATE_WATER_REPLAY/
/.local-data/
/ai-service/.cache/
/ai-service/.venv*/

# env files (can opt-in for committing if needed)
.env*
.env*.local
!.env.example

# IDE / Editor
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/

# scratch & temporary tools
/scratch/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
