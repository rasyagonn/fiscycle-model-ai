# Server-side only. Jangan memakai NEXT_PUBLIC_ untuk token atau URL AI privat.
FISCYCLE_AI_API_URL=http://127.0.0.1:8001
FISCYCLE_AI_API_KEY=
# false menutup proxy pada production. Untuk demo internal saja, aktifkan true.
# Untuk deployment publik, integrasikan otorisasi server backend utama terlebih dahulu.
FISCYCLE_AI_PROXY_ENABLED=false
# Replay lokal privat: CSV dan metadata disimpan di luar repo.
# FISCYCLE_WATER_REPLAY_CSV=../FISCYCLE_PRIVATE_REPLAY/water_replay_v1.csv
# Opsional: Python khusus; default ai-service/.venv/Scripts/python.exe (Windows).
# FISCYCLE_AI_PYTHON=
