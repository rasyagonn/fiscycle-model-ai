# Tidak ada secret nyata. Default aplikasi adalah local; .env tidak dimuat otomatis.
# Set environment variable melalui shell, platform deploy, atau docker --env-file.
FISCYCLE_MODEL_SOURCE=local
FISCYCLE_RUNTIME_ENV=production
FISCYCLE_AI_SERVICE_TOKEN=
# Produksi wajib mengisi token kuat. Testing localhost dapat memakai development tanpa token.
# FISCYCLE_WATER_REPLAY_CSV=/private/water_replay_v1.csv
